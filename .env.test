# Test environment — local Docker PostgreSQL (internal-dashboard-db-1)
# Usage: copy to .env and fill in API keys before running
#   cp .env.test .env

POSTGRES_DSN=postgresql://root:YOUR_PASSWORD@localhost:5432/monitoring

# Buyer pipeline feature flags
BUYER_PROMPT_VERSION=bp-v3
BUYER_GROUP_CONTEXT_ENABLED=true
BUYER_BIO_CONTEXT_ENABLED=true
# BUYER_RAG_PATH=  # defaults to data/rag/chroma

# LLM API keys (fill in before running)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
PSP_PROVIDERS_OPENROUTER_API_KEY=
TRAFFIC_OPENROUTER_API_KEY=
CRYPTO_CARDS_OPENROUTER_API_KEY=
IBAN_LEADS_OPENROUTER_API_KEY=
CASINO_PLATFORMS_API_KEY=
CRYPTO_BUYERS_API_KEY=

# LLM routing — all OpenAI SDK calls go through OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model overrides
GLOSSARY_MODEL=openai/gpt-4.1-nano
JUDGE_MODEL=google/gemini-3.1-flash-lite
PROVIDER_STAGE1_MODEL=openai/gpt-4.1-mini
TRAFFIC_STAGE1_MODEL=openai/gpt-4.1-mini
TRAFFIC_EXTRACTOR_MODEL=openai/gpt-4.1-mini
TRAFFIC_JUDGE_MODEL=google/gemini-3.1-flash-lite
CRYPTO_CARDS_STAGE1_MODEL=openai/gpt-4.1-nano
CRYPTO_CARDS_JUDGE_MODEL=openai/gpt-4.1-mini
