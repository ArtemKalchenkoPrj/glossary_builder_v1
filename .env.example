# Template for .env. Commit THIS file, never .env. Secrets are left empty.
# Keep it in sync with the code and with prod:  python check_env.py [path/to/.env] [--code]
# Non-secret values below mirror the prod configuration (checked 2026-11-19).

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#TABLE_PREFIX=test_          # JUST FOR TESTS: prefixes DB table names

# ── API docs basic auth (webhook.py) ────────────────────────────────────────
DOCS_LOGIN=
DOCS_PASSWORD=
#DOCS_USER=                  # legacy fallback names, defaults admin / changeme
#DOCS_PASS=

# ── LLM providers / keys ────────────────────────────────────────────────────
# Provide ONE of OpenAI-compatible or Anthropic as the default provider (see GLOSSARY_PROVIDER).
GLOSSARY_PROVIDER=openai          # anthropic | openai | ollama | auto
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=                   # buyer pipeline LLM + RAG embeddings
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=                # Haiku/Sonnet stages (provider, traffic, buyer gate); OpenRouter fallback on 400/429
#OLLAMA_BASE_URL=http://localhost:11434/v1   # disabled: takes precedence over GLOSSARY_PROVIDER

# Per-pipeline OpenRouter keys
PSP_PROVIDERS_OPENROUTER_API_KEY=
IBAN_LEADS_OPENROUTER_API_KEY=
CASINO_PLATFORMS_API_KEY=
CRYPTO_BUYERS_API_KEY=
TRAFFIC_OPENROUTER_API_KEY=
CRYPTO_CARDS_OPENROUTER_API_KEY=
TAVILY_API_KEY=                   # offline glossary research only

# ── Default / shared models ─────────────────────────────────────────────────
GLOSSARY_MODEL=openai/gpt-4.1-nano
JUDGE_MODEL=google/gemini-3.1-flash-lite
GLOSSARY_CONCURRENCY=2            # max LLM requests in flight (offline tooling)
#PSP_PROVIDERS_MODEL=openai/gpt-4.1-nano
#PROVIDER_JUDGE_MODEL=

# ── Buyer pipeline ──────────────────────────────────────────────────────────
BUYER_PROMPT_VERSION=bp-v4
BUYER_GROUP_CONTEXT_ENABLED=true
BUYER_BIO_CONTEXT_ENABLED=true
BUYER_ANTI_FILTER_ENABLED=true
BUYER_STAGE1_ENABLED=true
BUYER_STAGE1_MODEL=claude-haiku-5-5
BUYER_GATE_ENABLED=true
BUYER_GATE_MODEL=claude-haiku-5-5
#BUYER_RAG_PATH=                  # defaults to data/rag/chroma
#CRYPTO_BUYER_VERTICAL_DIR=

# ── Provider (PSP supply) pipeline ──────────────────────────────────────────
PROVIDER_STAGE1_MODEL=openai/gpt-4.1-mini        # noticeably raises recall vs nano
PROVIDER_STAGE1_ANTHROPIC_MODEL=claude-haiku-5-5
PROVIDER_EXTRACTOR_ANTHROPIC_MODEL=claude-haiku-5-5
PROVIDER_JUDGE_ANTHROPIC_MODEL=claude-haiku-5-5
PROVIDER_JUDGE_PROMPT=codebook                   # 3-way judge, writes certainty

# ── Traffic pipeline ────────────────────────────────────────────────────────
TRAFFIC_STAGE1_MODEL=openai/gpt-4.1-mini
TRAFFIC_EXTRACTOR_ANTHROPIC_MODEL=claude-haiku-5-5   # Haiku extractor via Anthropic (falls back to TRAFFIC_EXTRACTOR_MODEL)
TRAFFIC_EXTRACTOR_MODEL=openai/gpt-4.1-mini
TRAFFIC_JUDGE_MODEL=google/gemini-3.1-flash-lite
TRAFFIC_GATE_ENABLED=1                           # certainty gate + mismatch resolver
#TRAFFIC_GATE_MODEL=claude-haiku-5-5
#TRAFFIC_GATE_RESOLVER_MODEL=claude-sonnet-5-5
TRAFFIC_MERCHANT_GATE_ENABLED=1                  # is_merchant for seeking_traffic leads
#TRAFFIC_MERCHANT_GATE_MODEL=claude-haiku-5-5
# traffic_type: off (default) | shadow (annotate + log "[traffic_type] would_drop", drop nothing) | enforce
# enforce: messages offering ONLY a database / ONLY infrastructure are not leads (verdict MISTAKE, judge skipped).
# Note: shadow/enforce add a codebook block to the extractor prompt; roll out shadow first. Rollback: off.
TRAFFIC_TYPE_MODE=enforce

# ── Crypto cards pipeline ───────────────────────────────────────────────────
CRYPTO_CARDS_STAGE1_MODEL=openai/gpt-4.1-nano
CRYPTO_CARDS_JUDGE_MODEL=openai/gpt-4.1-mini
